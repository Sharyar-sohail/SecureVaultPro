# SECURE VAULT PRO — Keystore Configuration Template
# For local release signing, rename or copy this file to 'keystore.properties' and fill in your values.
# NEVER commit the actual keystore.properties or release.jks to public version control.

storeFile=release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
