# Build outputs — regenerated by ./gradlew, never versioned
/build
**/build/
.gradle/
.kotlin/
local.properties

# Signing material and credentials stay on this machine.
# The release keystore and its passwords must never enter history; the build
# reads them from these paths (see keystore.properties / signingConfigs).
*.jks
*.keystore
keystore.properties

# Firebase config carries the live client id / api key pair. It is deliberately
# kept out of history — restore it from the owner's copy before a signed build.
google-services.json

# Shipped binaries: the APK/AAB and Blogger theme XML are published as release
# artifacts (links + file paths), not as source.
*.apk
*.aab
/Blogger-Theme-*.xml
/SecureWalletPro-Blogger-Theme-*.xml
/SecureWallet_Blogger_Theme_*.xml
/secure_wallet_blogger_theme.xml

# Manual rollback snapshots and exported user data. These hold vault/WhatsApp
# content, so they are never committed.
/backup_*
/checkpoint-*
/checkpoint_*
/theme_backup/
/feature_backup/
/whatsapp_chat_backup/
/*_checkpoint_pre/

# Tooling caches
node_modules/
/tools/brand-icons/tmp/
/.stego_harvest/
*.log
*.tmp

# Local Qoder workspace markers — app metadata, not project source.
*.qoder.site

# A stale 3.3.4 theme export carried an embedded Firebase apiKey. Shipped themes
# must ship with a blank SEED and no injected cloud config, so published
# snapshots under release-site/ stay out of history.
/release-site/Blogger-Theme-*.xml
