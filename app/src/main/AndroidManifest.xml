<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The dead man's switch records a missed deadline at boot so the next launch enforces it.
         The receiver only reads dates; it never erases anything itself. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: without this, an ACTION_IMAGE_CAPTURE intent
         finds no camera app and the scan silently fails. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <!-- Needed to launch WhatsApp and to know whether it is installed.
             The Business package is com.whatsapp.w4b; the older spelling below was
             never visible, so Business always reported as "not installed". -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Lets the export chooser resolve a chat-share target on Android 13+. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureWalletPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SecureWalletPro"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Path A of the WhatsApp import: WhatsApp's own "Export chat" hands the .txt or .zip
                 to the share sheet, and this filter is what puts Secure Wallet Pro in that sheet.
                 A normal app cannot read WhatsApp's private storage on Android 11+, and
                 Android/media/WhatsApp/Databases is not reachable through SAF, so this hand-over
                 is the only way a whole conversation can arrive without root. The MIME type a
                 WhatsApp export carries varies by handset and by version, and ACTION_SEND_MULTIPLE
                 appears when an export is split into parts, so both actions are registered and the
                 type filter stays open — the importer sniffs the bytes instead of the label. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="multipart/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name="com.securevault.pro.autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Boot-time dead man's switch check. Not exported (only the system's protected
             broadcasts reach it), and it only persists an overdue flag: enforcement waits for the
             next app launch, where the session can be locked and an archive uploaded first. -->
        <receiver
            android:name=".security.DeadManBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase must never start during process bring-up. This app has been killed by
             static initialisers on the owner's handset, and the library's own provider runs
             before Application.onCreate, where a failure has no name and no log. Firebase is
             initialised lazily and inside a guard by FirebaseBootstrap instead. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

    </application>
</manifest>
